# ════════════════════════════════════════════════════════════
# MetaTrader 5 Credentials (Required)
# ════════════════════════════════════════════════════════════
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=MetaQuotes-Demo

# Optional: Path to MT5 terminal executable (auto-detected if not specified)
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal.exe

# Auto-launch MT5 if closed (true/false)
MT5_AUTO_LAUNCH=true

# ════════════════════════════════════════════════════════════
# FREE AI Provider Keys (choose ONE, or just use Ollama)
# ════════════════════════════════════════════════════════════

# Ollama (LOCAL, 100% FREE - no key needed)
# Just install from https://ollama.ai and run: ollama serve
# OLLAMA_ENDPOINT=http://localhost:11434

# Groq API (FREE tier, 30k tokens/min, fastest)
# Signup: https://console.groq.com
# GROQ_API_KEY=gsk_...

# OpenRouter (FREE $5 credit, 200+ models, no credit card)
# Signup: https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...

# ════════════════════════════════════════════════════════════
# AI Trading Pipeline Configuration
# ════════════════════════════════════════════════════════════

AI_PROVIDER=ollama
AI_MODEL=qwen:7b
AI_TEMPERATURE=0.7

DRY_RUN=true
TRADING_SYMBOLS=EURUSD,GBPUSD
TRADING_TIMEFRAMES=H1,H4

MAX_DAILY_LOSS_PERCENT=2.0
MAX_POSITION_SIZE_LOTS=1.0
MIN_RR_RATIO=2.0

LOG_LEVEL=INFO

# ════════════════════════════════════════════════════════════
# MCP Server Configuration (optional)
# ════════════════════════════════════════════════════════════

MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8080

# ════════════════════════════════════════════════════════════
# Notifications (optional)
# ════════════════════════════════════════════════════════════

# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
